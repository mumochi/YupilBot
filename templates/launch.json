        {
            "name": "Prod",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env",
            "env": {"YUPIL_ENV": "prod"}      
        }
    ]
}
